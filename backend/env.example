# Servidor Express
PORT=3000
NODE_ENV=development

# Base de datos PostgreSQL (Cadena de conexión para T-13 y T-14)
DATABASE_URL=postgresql://fluxpos_app:cambia_esta_clave@localhost:5432/fluxpos

# Configuración de CORS (origen del frontend)
CORS_ORIGIN=http://localhost:5173

# Autenticación JWT (Sesiones)
JWT_SECRET=cambia_este_valor_por_una_cadena_secreta_larga_y_aleatoria
JWT_EXPIRES_IN=8h

# Semilla de Administrador Inicial
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_PASSWORD=cambia_esta_clave